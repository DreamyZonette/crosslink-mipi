  BUFBA CLKDRXLPP_buf( .A(CLKDRXLPPin), .Z(CLKDRXLPPout));
  BUFBA CLKDRXLPN_buf( .A(CLKDRXLPNin), .Z(CLKDRXLPNout));
  BUFBA CLKDCDN_buf( .A(CLKDCDNin), .Z(CLKDCDNout));
  BUFBA HSBYTECLKS_buf( .A(HSBYTECLKSin), .Z(HSBYTECLKSout));
  BUFBA LOCK_buf( .A(LOCKin), .Z(LOCKout));

  specify
    (HSBYTECLKDin => D0HSRXDATA0out) = (0:0:0,0:0:0);
    (HSBYTECLKDin => D0HSRXDATA1out) = (0:0:0,0:0:0);
    (HSBYTECLKDin => D0HSRXDATA2out) = (0:0:0,0:0:0);
    (HSBYTECLKDin => D0HSRXDATA3out) = (0:0:0,0:0:0);
    (HSBYTECLKDin => D0HSRXDATA4out) = (0:0:0,0:0:0);
    (HSBYTECLKDin => D0HSRXDATA5out) = (0:0:0,0:0:0);
    (HSBYTECLKDin => D0HSRXDATA6out) = (0:0:0,0:0:0);
    (HSBYTECLKDin => D0HSRXDATA7out) = (0:0:0,0:0:0);
    $width (posedge CKNin, 0:0:0);
    $width (negedge CKNin, 0:0:0);
    $width (posedge CKPin, 0:0:0);
    $width (negedge CKPin, 0:0:0);
  endspecify

endmodule

