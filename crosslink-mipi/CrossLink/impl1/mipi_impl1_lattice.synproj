-a "LIFMD"
-d LIF-MD6000
-t CKFBGA80
-s 6
-frequency 200
-optimization_goal Timing
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-force_gsr Auto
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-mux_style Auto
-max_fanout 1000
-fsm_encoding_style Auto
-twr_paths 3
-fix_gated_clocks 1
-loop_limit 1950




-use_io_insertion 1
-resolve_mixed_drivers 0
-use_io_reg auto


-lpf 1
-p "D:/project/crosslink-mipi/crosslink-mipi/CrossLink"
-ver "D:/project/crosslink-mipi/crosslink-mipi/CrossLink/mipi_3ch_top.v"
"D:/project/crosslink-mipi/crosslink-mipi/CrossLink/impl1/source/uart_tx.v"
